<Window x:Class="_9.ariketa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_9.ariketa"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="518"
        Width="452">

    <Grid Margin="0,-18,0,-6">

        <Button Content="Gehitu"
                HorizontalAlignment="Left"
                Height="48"
                Margin="313,135,0,0"
                VerticalAlignment="Top"
                Width="85"
                Click="gehitu"/>

        <Button Content="Ezabatu"
                HorizontalAlignment="Left"
                Height="48"
                Margin="313,215,0,0"
                VerticalAlignment="Top"
                Width="85"
                Click="ezabatu"/>

        <Button Content="Zerrenda garbitu"
                HorizontalAlignment="Left"
                Height="48"
                Margin="313,295,0,0"
                VerticalAlignment="Top"
                Width="85"
                Click="garbitu"/>

        <Label Content="Lagunak"
               HorizontalAlignment="Left"
               Height="27"
               Margin="42,89,0,0"
               VerticalAlignment="Top"
               Width="82"/>

        <ListBox x:Name="lagunListaLB"
                 SelectionMode="Multiple"
                 HorizontalAlignment="Left"
                 Height="221"
                 Margin="28,135,0,0"
                 VerticalAlignment="Top"
                 Width="172"/>

        <Label Content="Hautatutako laguna"
               HorizontalAlignment="Left"
               Height="28"
               Margin="278,380,0,0"
               VerticalAlignment="Top"
               Width="120"/>

        <TextBox x:Name="hautatutakoLagunaTB"
                 HorizontalAlignment="Left"
                 Height="35"
                 Margin="278,432,0,0"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top"
                 Width="120"/>

        <Label Content="Lagun berria"
               HorizontalAlignment="Left"
               Height="28"
               Margin="64,380,0,0"
               VerticalAlignment="Top"
               Width="85"/>

        <TextBox x:Name="lagunBerriaTB"
                 HorizontalAlignment="Left"
                 Height="35"
                 Margin="64,432,0,0"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top"
                 Width="120"/>

    </Grid>
</Window>